# Node.js 22.12+ required. Copy this file to .env for local use.
DATABASE_URL="file:./dev.db"
# Keep demo mode on for local testing. It enables explicit employee impersonation
# and labeled local test events. Never expose demo mode to an untrusted network.
DEMO_MODE="true"

# Ring Playground: generate at https://developer.amazon.com/ring/console/playground
# Keep all credentials server-side; never prefix them with NEXT_PUBLIC_.
# Choose either access token OR refresh token mode, never both.
RING_ACCESS_TOKEN=""
RING_REFRESH_TOKEN=""
RING_CLIENT_ID=""
RING_CLIENT_SECRET=""

# For registered partner webhook configurations (not needed for Playground video).
# Use the partner-issued HMAC signing key, not an OAuth access token.
RING_WEBHOOK_SIGNING_KEY=""
# The account linked to this single-business workspace; required for webhook ingestion.
RING_ACCOUNT_ID=""

# Same webhook endpoint, explicitly labeled local signing tests. Default partner
# mode preserves existing behavior. Simulated mode also requires DEMO_MODE=true.
# Leave real Ring credentials intact; use a DIFFERENT local test signing key.
RING_WEBHOOK_MODE="partner"
RING_SIMULATED_WEBHOOK_SIGNING_KEY=""
RING_SIMULATED_ACCOUNT_ID=""

# Required with DEMO_MODE=false. Use separate, random secrets.
APP_SESSION_SECRET=""
APP_ADMIN_PASSWORD=""
# Exact external origin if a trusted reverse proxy changes Request.url.
APP_ORIGIN=""
NEXT_TELEMETRY_DISABLED="1"
